{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AegisWeft Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "version",
    "name",
    "states",
    "transitions",
    "requiredArtifacts"
  ],
  "properties": {
    "kind": {
      "const": "workflow"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "requires"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "requiredArtifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
