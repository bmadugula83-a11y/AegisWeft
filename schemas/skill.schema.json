{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AegisWeft Skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "version",
    "name",
    "category",
    "useWhen",
    "inputs",
    "procedure",
    "outputs",
    "safety",
    "completionChecks"
  ],
  "properties": {
    "kind": {
      "const": "skill"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "useWhen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "procedure": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completionChecks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
