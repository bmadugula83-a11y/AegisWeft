{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AegisWeft Project Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectName",
    "languageAndFrameworks",
    "commands",
    "repositoryRules",
    "dataClassification",
    "approvedProviders",
    "enabledToolConnectors",
    "approvalGates"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "projectName": {
      "type": "string"
    },
    "languageAndFrameworks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "repositoryRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataClassification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "approvedProviders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enabledToolConnectors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvalGates": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  }
}
